# =============================================================================
# CentRAG Environment Configuration
# Copy this file: cp .env.example .env
# NEVER commit .env to version control
# =============================================================================

# --- Application ---
CENTRAG_ENV=development
CENTRAG_DEBUG=true
CENTRAG_LOG_LEVEL=DEBUG
CENTRAG_API_HOST=0.0.0.0
CENTRAG_API_PORT=8000

# --- PostgreSQL (Aurora in production) ---
CENTRAG_PG_HOST=localhost
CENTRAG_PG_PORT=5432
CENTRAG_PG_DB=centrag
CENTRAG_PG_USER=centrag
CENTRAG_PG_PASSWORD=centrag_dev_only
CENTRAG_PG_POOL_MIN=2
CENTRAG_PG_POOL_MAX=10

# --- Redis (ElastiCache in production) ---
CENTRAG_REDIS_URL=redis://localhost:6379/0
CENTRAG_CACHE_TTL_SECONDS=3600

# --- Qdrant (Self-hosted in production) ---
CENTRAG_QDRANT_HOST=localhost
CENTRAG_QDRANT_PORT=6333
CENTRAG_QDRANT_GRPC_PORT=6334
CENTRAG_QDRANT_COLLECTION=documents
CENTRAG_QDRANT_CACHE_COLLECTION=cache_responses
CENTRAG_QDRANT_MEMORY_COLLECTION=memories

# --- AWS (Bedrock, S3, SQS, KMS) ---
CENTRAG_AWS_REGION=us-east-1
CENTRAG_S3_BUCKET=centrag-documents-dev
CENTRAG_SQS_QUEUE_URL=
CENTRAG_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
CENTRAG_BEDROCK_LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Cohere (Re-ranking) ---
CENTRAG_COHERE_API_KEY=

# --- Langfuse (Observability) ---
CENTRAG_LANGFUSE_PUBLIC_KEY=
CENTRAG_LANGFUSE_SECRET_KEY=
CENTRAG_LANGFUSE_HOST=https://cloud.langfuse.com

# --- Security ---
CENTRAG_API_KEY_HASH_PEPPER=change-this-in-production
CENTRAG_RATE_LIMIT_DEFAULT=60
